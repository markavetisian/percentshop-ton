# Demo mode: simulated in-page wallet, no wallet app or funds needed. (Or just open the app with ?demo)
VITE_DEMO_MODE=false

# testnet (default) or mainnet
VITE_NETWORK=testnet

# Currency label shown in the UI (Toncoin was renamed GRAM in June 2026)
VITE_TICKER=TON

# Wallet that receives (optional in demo mode) the 0.05 TON test payment.
# Use a TESTNET address while src/config.ts has NETWORK = 'testnet'.
VITE_RECIPIENT_ADDRESS=

# Optional. Defaults to <current origin>/tonconnect-manifest.json, which the build generates
# (url = TONCONNECT_APP_URL, else Vercel's production domain). Wallets must reach it over public HTTPS.
VITE_TONCONNECT_MANIFEST_URL=

# Optional. Raises the TON Center rate limit used to confirm the transaction (get one from @tonapibot on Telegram).
VITE_TONCENTER_API_KEY=
